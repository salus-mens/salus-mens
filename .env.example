# Copia este archivo como ".env" y completa los datos. El archivo .env NO se sube a git.

# Dirección pública del sitio, usada en el enlace del correo "Olvidé mi contraseña"
BASE_URL=http://127.0.0.1:5050

# Puerto del servidor (por defecto 5050)
# PORT=5050

# Cuenta de correo que envía los enlaces de recuperación.
# Gmail:   SMTP_HOST=smtp.gmail.com         SMTP_PORT=465  (requiere "contraseña de aplicación")
# Outlook: SMTP_HOST=smtp-mail.outlook.com  SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Salus Mens <salus_mens@outlook.com>"

# Clave para firmar las sesiones (cualquier texto largo y aleatorio)
SESION_SECRETO=
