# Copia este archivo como ".env" y completa los datos. El archivo .env NO se sube a git.

# Dirección pública del sitio, usada en el enlace del correo "Olvidé mi contraseña"
BASE_URL=http://127.0.0.1:5050

# Puerto del servidor (por defecto 5050)
# PORT=5050

# Cuenta de correo que envía los enlaces de recuperación.
# Gmail:   SMTP_HOST=smtp.gmail.com         SMTP_PORT=465  (requiere "contraseña de aplicación")
# Outlook: SMTP_HOST=smtp-mail.outlook.com  SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Salus Mens <salus_mens@outlook.com>"

# Clave para firmar las sesiones (cualquier texto largo y aleatorio)
SESION_SECRETO=

# ===================== ASISTENTE VIRTUAL (WhatsApp, Messenger, Instagram) =====================
# Interruptor general: true = activado. Está apagado hasta completar la verificación del negocio en Meta.
CHATBOT_ACTIVO=false
# Guía paso a paso: guias/asistente-virtual.md

# IA (Claude): clave de https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Opcional: modelo y nivel de esfuerzo (low, medium, high). Por defecto claude-opus-5-5 y medium.
# CHATBOT_MODELO=claude-opus-5-5
# CHATBOT_ESFUERZO=medium
# menu = usar solo las respuestas automáticas por menú (sin IA, sin costo). Por defecto: IA con respaldo de menú
# CHATBOT_MODO=menu

# Meta (WhatsApp Cloud API, Messenger e Instagram) — developers.facebook.com
META_VERIFY_TOKEN=
META_APP_SECRET=
META_APP_ID=
# Versión de la API de Meta (la que muestra tu app); por defecto v26.0
# META_GRAPH_VERSION=v26.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Messenger e Instagram (token de la página de Facebook vinculada a la cuenta de Instagram)
META_PAGE_TOKEN=
# Opcional: token de "Instagram API con inicio de sesión de Instagram" (si no usas el de la página)
# INSTAGRAM_TOKEN=

# Google Calendar del consultorio
# ID del calendario (normalmente el correo de Gmail del consultorio)
GOOGLE_CALENDAR_ID=
# Archivo JSON de la cuenta de servicio de Google Cloud (guárdalo en la carpeta del proyecto, NO se sube a git)
GOOGLE_SERVICE_ACCOUNT_FILE=google-cuenta-servicio.json

# Correo que recibe los avisos de citas, comprobantes y derivaciones (usa la cuenta SMTP de arriba)
CHATBOT_AVISOS_CORREO=salus_mens@outlook.com
